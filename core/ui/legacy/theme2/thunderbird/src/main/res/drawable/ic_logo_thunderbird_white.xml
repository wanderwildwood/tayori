<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher foreground, on the white background of ic_launcher.xml. A sealed envelope: the page, the flap, and one droplet where the seal sits.

     Drawn to the rules in kinokocho/tools/make-art.py, as Calendar's is: a thin line, one weight
     all through, few strokes, crooked rather than square, and no solid black except the droplet.
     Everything sits inside the central 66 units the launcher mask is certain to keep. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the envelope: one line, a touch wider than tall, the right side leaning -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#FFFFFF00"
        android:pathData="M31.4,40.2 C46.2,39.4 62.8,39.6 77.2,40.6 C77.9,50.8 77.6,61.4 76.8,71.6 C61.9,72.4 46.1,72.2 31.8,71.4 C31.0,61.0 30.9,50.6 31.4,40.2 Z" />

    <!-- the flap, folded down to a point a little left of centre -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#FFFFFF00"
        android:pathData="M32.0,41.4 C39.8,47.6 46.6,53.0 53.2,57.4 C60.4,52.8 68.2,47.2 76.4,41.6" />

    <!-- the seal: a droplet, the one fill a page of thin lines can carry -->
    <path android:fillColor="#FFFFFF"
        android:pathData="M53.3,54.2 A3.4,3.3 0 1 0 53.4,54.2 Z" />
</vector>
